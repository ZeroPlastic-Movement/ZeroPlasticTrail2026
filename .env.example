# Server-side only. Set the real value in the Vercel dashboard
# (Project → Settings → Environment Variables), never in this repo.
#
# Deliberately NOT prefixed with VITE_: Vite compiles every VITE_* variable
# into the browser bundle, which would publish the token to every visitor.
MONDAY_API_TOKEN=

# Optional. Pin the Monday.com API version, e.g. 2025-01.
# Leave blank to track Monday's current stable version.
MONDAY_API_VERSION=

# Optional. Defaults to the Trail 2026 participants board.
MONDAY_BOARD_ID=5031418117
